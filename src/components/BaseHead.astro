---
import "../styles/global.css";
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1.0" />

<!-- Basic Meta Tags -->
<title>AFDev - Web & Mobile Development</title>
<meta
  name="description"
  content="AFDev builds websites and mobile apps tailored to your needs. Get AI-assisted design or bring your own, with personalized quotation through WhatsApp consultation."
/>
<meta
  name="keywords"
  content="web development, mobile apps, Flutter, website maintenance, freelance developer, Malaysia"
/>
<meta name="author" content="Amer Fathullah" />

<!-- Canonical URL -->
<link rel="canonical" href="https://dev.amerfathullah.com/" />

<!-- Favicons -->
<link rel="icon" href="/favicon.ico" sizes="any" />
<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<!-- Favicon for different sizes -->
<link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content="https://dev.amerfathullah.com/" />
<meta property="og:title" content="AFDev - Web & Mobile Development" />
<meta
  property="og:description"
  content="AFDev builds websites and mobile apps tailored to your needs. Get AI-assisted design or bring your own, with personalized quotation through WhatsApp consultation."
/>
<meta
  property="og:image"
  content="https://dev.amerfathullah.com/og-image.png"
/>

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content="https://dev.amerfathullah.com/" />
<meta property="twitter:title" content="AFDev - Web & Mobile Development" />
<meta
  property="twitter:description"
  content="AFDev builds websites and mobile apps tailored to your needs. Get AI-assisted design or bring your own, with personalized quotation through WhatsApp consultation."
/>
<meta
  property="twitter:image"
  content="https://dev.amerfathullah.com/og-image.png"
/>

<meta name="robots" content="index, follow" />
<meta name="googlebot" content="index, follow" />

<!-- Apple Touch Icon -->
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

<!-- Theme Color for Mobile Browsers -->
<meta name="theme-color" content="#ffffff" />

<!-- For IE -->
<meta http-equiv="X-UA-Compatible" content="IE=edge" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />

<!-- Async load Google Fonts -->
<link
  rel="preload"
  as="style"
  href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap"
/>
<link
  href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap"
  rel="stylesheet"
  media="print"
  onload="this.media='all'"
/>
<noscript>
  <link
    href="https://fonts.googleapis.com/css2?family=Geist:wght@100..900&display=swap"
    rel="stylesheet"
  />
</noscript>

<!-- Async load Keen Slider CSS -->
<link
  rel="preload"
  as="style"
  href="https://cdn.jsdelivr.net/npm/keen-slider@6.8.6/keen-slider.min.css"
/>
<link
  href="https://cdn.jsdelivr.net/npm/keen-slider@6.8.6/keen-slider.min.css"
  rel="stylesheet"
  media="print"
  onload="this.media='all'"
/>
<noscript>
  <link
    href="https://cdn.jsdelivr.net/npm/keen-slider@6.8.6/keen-slider.min.css"
    rel="stylesheet"
  />
</noscript>
