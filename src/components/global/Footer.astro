---
const currentYear = new Date().getFullYear();
const footerLinks = [
  {
    title: "Navigation",
    links: [
      { label: "Work", href: "#work" },
      { label: "How it works", href: "#how" },
      { label: "Services", href: "#services" },
      { label: "FAQ", href: "#faq" },
    ],
  },
  {
    title: "Contact",
    links: [
      {
        label: "WhatsApp",
        href: "https://wa.me/601154229874",
      },
    ],
  },

  {
    title: "Socials",
    links: [
      {
        label: "Portfolio",
        href: "https://amerfathullah.com",
      },
    ],
  },
];
---

<footer class="overflow-hidden">
  <div class="px-8 pt-6 pb-12 max-w-4xl mx-auto">
    <div class="flex justify-between">
      {
        footerLinks.map((section) => (
          <div>
            <h3 class="text-base-900 text-sm">{section.title}</h3>
            <ul
              role="list"
              class="mt-2 text-sm flex flex-col gap-1 text-base-600"
            >
              {section.links.map((link) => (
                <li>
                  <a
                    href={link.href}
                    class="hover:text-base-900 underline decoration-base-300 hover:decoration-base-900"
                  >
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
    <div class="mt-12 text-center">
      <div class="text-sm text-base-900">
        © {currentYear} Amer Fathullah. All rights reserved.
      </div>
    </div>
  </div>
</footer>
