---
const faqs = [
  {
    question: "Who runs AF Tech?",
    answer:
      "My name is Amer Fathullah, a Full-Stack Developer. I build websites, mobile apps, and help maintain existing projects. Learn more at amerfathullah.com.",
  },
  {
    question: "How does the consultation process work?",
    answer:
      "Simply reach out via WhatsApp with your project idea. We'll discuss your requirements, timeline, and goals. Based on our conversation, I'll provide a personalized quotation.",
  },
  {
    question: "What design options are available?",
    answer:
      "You have flexibility here! I can create designs using AI-assisted tools, implement your existing design files, or work with designs from your own designer. Just bring your vision.",
  },
  {
    question: "Do you develop mobile apps?",
    answer:
      "Yes! I build cross-platform mobile apps using Flutter, covering both iOS and Android with a single codebase. This includes App Store and Play Store deployment.",
  },
  {
    question: "What do you need for maintenance work?",
    answer:
      "For maintenance of existing websites or mobile apps, I'll need access to the source code. This allows me to understand the current setup and make updates, bug fixes, or add new features.",
  },
  {
    question: "How quickly can you complete a project?",
    answer:
      "Timelines depend on project complexity. Simple websites can be done in 1-2 weeks, while larger projects may take 4-8 weeks. We'll discuss realistic timelines during our consultation.",
  },
];
---

<section>
  <div class="px-8 py-6 max-w-4xl mx-auto">
    <h2
      class="text-4xl tracking-tight text-base-900 text-balance font-medium text-center"
    >
      The answers to the most <span class="block"
        >popular frequent questions</span
      >
    </h2>
    <p class="mt-2 text-sm text-base-600 text-center">
      Can't find your answer? Reach out via
      <a
        class="text-green-700 underline hover:text-base-900 duration-200"
        href="https://wa.me/601154229874"
      >
        WhatsApp
      </a>
      and AF Tech will get back to you.
    </p>

    <div
      class="mt-8 bg-white rounded-3xl text-base-900 divide-y divide-base-100"
    >
      {
        faqs.map((faq, i) => (
          <details class="px-8 py-6 group">
            <summary class="cursor-pointer text-sm font-medium  flex justify-between items-center">
              {faq.question}
              <svg
                class="size-4 ml-2 transform transition-transform group-open:rotate-180"
                fill="currentColor"
                viewBox="0 0 20 20"
                xmlns="http://www.w3.org/2000/svg"
              >
                <path
                  fill-rule="evenodd"
                  d="M5.23 7.21a.75.75 0 011.06.02L10 10.939l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.24a.75.75 0 01-1.06 0l-4.24-4.24a.75.75 0 01.02-1.06z"
                  clip-rule="evenodd"
                />
              </svg>
            </summary>
            <p class="mt-2 text-sm text-base-600">{faq.answer}</p>
          </details>
        ))
      }
    </div>
  </div>
</section>
