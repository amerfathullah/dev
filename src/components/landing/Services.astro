---
const services = [
  {
    category: "Design",
    items: [
      "AI-assisted design creation",
      "Custom design implementation",
      "Bring your own design files",
      "Design consultation & guidance",
    ],
  },
  {
    category: "Web Development",
    items: [
      "Landing pages & marketing sites",
      "Business websites",
      "E-commerce solutions",
      "Web applications",
      "CMS integration (WordPress, Sanity, etc.)",
      "Performance & SEO optimization",
    ],
  },
  {
    category: "Mobile Apps",
    items: [
      "Cross-platform mobile apps (Flutter)",
      "iOS & Android development",
      "App Store & Play Store deployment",
      "Mobile UI/UX implementation",
    ],
  },
  {
    category: "Maintenance",
    items: [
      "Website updates & bug fixes",
      "Mobile app maintenance",
      "Feature enhancements",
      "Source code required for existing projects",
    ],
  },
];
---

<section>
  <div class="px-8 py-6 max-w-4xl mx-auto">
    <h2
      class="text-4xl tracking-tight text-base-900 text-balance font-medium text-center"
    >
      Services
    </h2>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mt-4">
      {
        services.map(({ category, items }) => (
          <div class="bg-white p-8 rounded-3xl">
            <h3
              id={`${category.toLowerCase()}-heading`}
              class="text-xl text-base-900"
            >
              {category}
            </h3>

            <ul
              role="list"
              class="grid grid-cols-1 gap-y-1 gap-x-4 mt-2 list-disc pl-4"
            >
              {items.map((title) => (
                <li class="text-sm text-base-600">{title}</li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </div>
</section>
